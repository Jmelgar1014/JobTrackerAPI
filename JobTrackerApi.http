@JobTrackerApi_HostAddress = http://localhost:8080
@AccessToken = eyJhbGciOiJIUzI1NiIsImtpZCI6ImdLd3BReVk3cE5iOC8wejQiLCJ0eXAiOiJKV1QifQ..BJoouJTztCZo2XyqxafKD-XsChl5nPnrwDZx8F-V0E

GET {{JobTrackerApi_HostAddress}}/api/jobapplication
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

# Pagination: first page of 5
GET {{JobTrackerApi_HostAddress}}/api/jobapplication?page=1&pageSize=5
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

# Pagination: second page of 5 (should not overlap with page 1)
GET {{JobTrackerApi_HostAddress}}/api/jobapplication?page=2&pageSize=5
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

# Pagination: page past the end (expect empty items, hasNextPage=false)
GET {{JobTrackerApi_HostAddress}}/api/jobapplication?page=999&pageSize=5
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

# Validation: page=0 (expect 400)
GET {{JobTrackerApi_HostAddress}}/api/jobapplication?page=0
Accept: application/json
Authorization: Bearer {{AccessToken}}

###

# Validation: pageSize over 60 (expect 400)
GET {{JobTrackerApi_HostAddress}}/api/jobapplication?pageSize=61
Accept: application/json
Authorization: Bearer {{AccessToken}}

###
